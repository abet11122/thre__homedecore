---
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { CATEGORIES, PRIMARY_CATEGORIES, categoryName, NAV_MIN_POSTS } from '../site';
import { getPublishedPosts } from '../lib/posts';
const posts = await getPublishedPosts();
const categories = CATEGORIES.filter(c => posts.filter(post => post.data.category === c.slug).length >= NAV_MIN_POSTS);
const primaryCategories = PRIMARY_CATEGORIES.filter(c => categories.includes(c));
const featured = posts.find(p => p.data.featured) ?? posts[0];
// These two slots used to name specific articles, which left holes in the
// homepage whenever one of them was withdrawn. They now pick from whatever is
// published: the weekend slot wants a making project, and the picks are simply
// the next most recent articles that are not already shown above.
const weekend = posts.find(p => p.data.category === 'diy-decor');
const picks = posts
  .filter(p => p.id !== featured?.id && p.id !== weekend?.id)
  .slice(0, 3);
---
<Layout title="Seasonal Decorating Ideas for a Home That Feels Like Autumn" description="Seasonal decorating guides for porches, tables, mantels and front doors — with the measurements, quantities and colour choices that make each one work.">
  <div class="home-note"><span>A little inspiration. A home that feels like you.</span><a href="/category/seasonal/">Decorating through the seasons <span aria-hidden="true">↗</span></a></div>
  <section class="wrap home-hero">
    <div class="home-hero-copy">
      <p class="eyebrow hero-kicker"><span aria-hidden="true"></span>The art of feeling at home</p>
      <h1>Small home ideas.<br /><em>A cozy life you love.</em></h1>
      <p>Home decor ideas for real rooms, real budgets, and your own kind of beautiful. Find the little changes that make you love coming home.</p>
      <div class="hero-actions"><a class="btn btn-primary" href="#find-ideas">Explore the ideas <span aria-hidden="true">↗</span></a><a class="quiet-link" href="#rooms-title">Find your room <span aria-hidden="true">→</span></a></div>
      <div class="hero-footnote"><span class="hero-monogram" aria-hidden="true">sch</span><div><strong>Good rooms start with a little inspiration.</strong><span>{posts.length} guides. Countless ways to make it yours.</span></div></div>
    </div>
    <div class="hero-composition">{featured && <a class="hero-feature" href={`/post/${featured.id}/`}>
      <Img src={featured.data.heroImage} alt={featured.data.title} width={900} height={1000} loading="eager" fetchpriority="high" sizes="(min-width: 900px) 48vw, 100vw" />
      <span class="feature-label"><span aria-hidden="true">✳</span> Featured guide</span>
      <div class="feature-caption"><span>{categoryName(featured.data.category)} / The considered home</span><h2>{featured.data.title}</h2><span class="feature-arrow" aria-hidden="true">↗</span></div>
    </a>}<span class="hero-margin-note" aria-hidden="true">Spaces to settle into.</span></div>
  </section>
  <div class="wrap"><div class="editorial-values"><span><i aria-hidden="true">01</i> Inspiration for every room</span><span><i aria-hidden="true">02</i> <a href="/tools/storage-fit-checker/">Check if storage fits your space ↗</a></span><span><i aria-hidden="true">03</i> A home that’s entirely yours</span></div></div>
  <section class="wrap room-section" aria-labelledby="rooms-title">
    <div class="home-section-head"><div><p class="eyebrow">Start somewhere you love</p><h2 id="rooms-title">Which room is on your mind?</h2></div><a class="quiet-link" href="/tags/">Explore all topics ↗</a></div>
    <div class="room-grid">{primaryCategories.map(c => {
      const count = posts.filter(p => p.data.category === c.slug).length;
      return <a href={`/category/${c.slug}/`} class="room-card"><div class="frame"><Img src={c.image} alt={`${c.name} decorating inspiration`} width={320} height={380} sizes="(min-width: 900px) 15vw, 45vw" /></div><span>{c.name}<span aria-hidden="true">↗</span></span><small>{count} decorating {count === 1 ? 'guide' : 'guides'}</small></a>;
    })}</div>
  </section>
  <section class="discovery-section" id="find-ideas" aria-labelledby="ideas-title">
    <div class="wrap">
      <div class="home-section-head"><div><p class="eyebrow">The inspiration library</p><h2 id="ideas-title">A little spark for your next refresh.</h2></div><p class="section-intro">Beautiful rooms, clever details, and ideas worth saving. Find something that feels like you.</p></div>
      <div class="idea-filters" aria-label="Filter ideas by room"><button data-room="all" aria-pressed="true">All ideas</button>{categories.map(c => <button data-room={c.slug} aria-pressed="false">{c.name}</button>)}</div>
      <p id="idea-count" class="idea-count" aria-live="polite">Explore {posts.length} decorating guides.</p>
      <div class="ideas-grid">{posts.map(post => <div data-idea-room={post.data.category}><PostCard post={post} /></div>)}</div>
    </div>
  </section>
  <div class="wrap"></div>
  {weekend && <section class="wrap weekend-section" aria-labelledby="weekend-title"><a class="weekend-photo frame" href={`/post/${weekend.id}/`}><Img src={weekend.data.heroImage} alt={weekend.data.title} width={900} height={680} sizes="(min-width: 900px) 48vw, 100vw" /></a><div class="weekend-copy"><p class="eyebrow">The weekend project</p><span class="weekend-number" aria-hidden="true">Made by you.</span><h2 id="weekend-title">A small project.<br />A lovely difference.</h2><p>A quiet afternoon, a few simple materials, and a corner that feels a little more yours.</p><a class="link-arrow" href={`/post/${weekend.id}/`}>Make something lovely <span aria-hidden="true">↗</span></a></div></section>}
  {picks.length > 0 && <section class="wrap budget-section" aria-labelledby="budget-title"><div class="home-section-head"><div><p class="eyebrow">Little changes, lovely results</p><h2 id="budget-title">Big on style. Kind to your budget.</h2></div><a class="quiet-link" href="/category/seasonal/">Explore seasonal ideas ↗</a></div><div class="grid gap-8 md:grid-cols-3">{picks.map(post => <PostCard post={post} />)}</div></section>}
  <div class="wrap my-16"><Newsletter /></div>
</Layout>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-room]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-idea-room]')];
  let active = 'all';
  function render() {
    const matching = cards.filter(card => active === 'all' || card.dataset.ideaRoom === active);
    cards.forEach(card => { card.hidden = true; });
    matching.forEach(card => { card.hidden = false; });
    document.querySelector('#idea-count')!.textContent = `Showing all ${matching.length} ${matching.length === 1 ? 'guide' : 'guides'}`;
  }
  filters.forEach(button => button.addEventListener('click', () => {
    active = button.dataset.room!;
    filters.forEach(filter => filter.setAttribute('aria-pressed', String(filter === button))); render();
  }));
  render();
</script>
