---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { readingTime } from '../../site';
import { getPublishedPosts } from '../../lib/posts';

/*
  Only published articles get a page.

  Withdrawn and merged URLs are deliberately not built. A merged URL is answered
  by the 301 in vercel.json; a withdrawn one returns 404. Building a "retired"
  notice for them instead, as this route used to, answered both with a thin 200
  page — which is exactly the kind of page that counts against the site.
*/
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingTime(post.body ?? '');
---

<PostLayout post={post} headings={headings} minutes={minutes}>
  <Content />
</PostLayout>
