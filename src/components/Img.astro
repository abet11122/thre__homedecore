---
import { articleImage } from '../lib/articleImages';
import { localImageSource } from '../lib/stockImages';
/**
 * Responsive image.
 *
 * Legacy Unsplash IDs resolve to the local stock-image manifest. Responsive
 * WebP variants and dimensions come from the local image records. Dimensions
 * reserve space while an image loads; they do not guarantee a zero CLS score.
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  sizes = '100vw',
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className = '',
} = Astro.props;

const localSource = localImageSource(src);
const localImage = articleImage(localSource);

const srcset = localImage?.srcset;
const finalSrc = localSource;

/*
  alt="" is a deliberate choice rather than a missing value: it marks an image
  as decorative, so a screen reader skips it instead of announcing a filename.
  Every caller passing alt="" here does so beside a visible label — a post
  title or a category name — which is the text a reader actually needs.

  It has to be written as a literal. An attribute whose value is an empty
  expression is dropped from the built HTML entirely, which left 46 images
  with no alt attribute at all — a different thing from a decorative one, and
  an accessibility failure. Hence the two branches.
*/
const altText = alt === '' ? '' : localImage?.alt || alt || '';
const w = localImage?.width ?? width;
const h = localImage?.height ?? height;
const decoding = loading === 'eager' ? 'sync' : 'async';
---

{altText === '' ? (
  <img
    src={finalSrc}
    srcset={srcset}
    sizes={srcset ? sizes : undefined}
    alt=""
    aria-hidden="true"
    width={w}
    height={h}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    class={className}
  />
) : (
  <img
    src={finalSrc}
    srcset={srcset}
    sizes={srcset ? sizes : undefined}
    alt={altText}
    width={w}
    height={h}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    class={className}
  />
)}
