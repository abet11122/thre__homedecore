---
import type { AffiliateProduct } from '../data/affiliateProducts';

interface Props {
  products: AffiliateProduct[];
}

const { products } = Astro.props;
---

{products.length > 0 && (
  <section class="product-recommendations" aria-labelledby="product-recommendations-title">
    <div class="product-recommendations-heading">
      <p class="eyebrow-muted">The shopping edit</p>
      <h2 id="product-recommendations-title">Useful pieces for this idea</h2>
      <p>Check the size and finish against your space before ordering.</p>
    </div>

    <div class="product-recommendations-grid">
      {products.map((product, index) => (
        <article class="product-card">
          <div class="product-card-topline">
            <span class="product-card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="product-card-brand">{product.brand}</span>
          </div>
          <h3>{product.name}</h3>
          <p class="product-card-variant">{product.variant}</p>
          <p class="product-card-details">{product.details}</p>
          <div class="product-card-footer">
            <span>ASIN {product.asin}</span>
            <a href={product.href} target="_blank" rel="sponsored noopener noreferrer">
              View on Amazon <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .product-recommendations {
    margin-top: 3.5rem;
    border-top: 1px solid #e5dcd0;
    padding-top: 2.5rem;
  }

  .product-recommendations-heading {
    max-width: 37rem;
  }

  .product-recommendations-heading h2 {
    margin: 0.6rem 0 0;
    font-family: 'Playfair Display', 'Playfair Fallback', Georgia, Cambria, 'Times New Roman', serif;
    font-size: clamp(1.7rem, 4vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .product-recommendations-heading > p:last-child {
    margin: 0.85rem 0 0;
    color: #4a423a;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .product-recommendations-grid {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  .product-card {
    position: relative;
    overflow: hidden;
    border: 1px solid #e5dcd0;
    background: linear-gradient(135deg, #f8f1ec 0%, #fbf8f4 58%);
    padding: 1.25rem;
  }

  .product-card::after {
    position: absolute;
    right: -1.15rem;
    top: -1.35rem;
    width: 5rem;
    height: 5rem;
    border: 1px solid rgb(176 91 56 / 0.24);
    border-radius: 999px;
    content: '';
  }

  .product-card-topline,
  .product-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .product-card-number,
  .product-card-brand,
  .product-card-variant,
  .product-card-footer {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .product-card-number {
    color: #b05b38;
  }

  .product-card-brand {
    color: #4a423a;
  }

  .product-card h3 {
    position: relative;
    z-index: 1;
    margin: 1.2rem 0 0;
    max-width: 28rem;
    font-family: 'Playfair Display', 'Playfair Fallback', Georgia, Cambria, 'Times New Roman', serif;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .product-card-variant {
    margin: 0.55rem 0 0;
    color: #b05b38;
  }

  .product-card-details {
    margin: 0.85rem 0 0;
    color: #4a423a;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .product-card-footer {
    margin-top: 1.15rem;
    border-top: 1px solid #e5dcd0;
    padding-top: 0.85rem;
    color: #4a423a;
    letter-spacing: 0.055em;
  }

  .product-card-footer a {
    color: #1f1b17;
    text-decoration: none;
  }

  .product-card-footer a:hover {
    color: #b05b38;
  }

  @media (min-width: 640px) {
    .product-recommendations-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product-card:only-child {
      grid-column: span 2;
    }
  }
</style>
